{
  "name": "oxidoc",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "overrides": {
    "dompurify": "3.4.17",
    "minimatch": "11.0.5"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rust": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check": "npm run version:check && npm run test:version && npm run test:release && npm run typecheck && npm run lint && npm run test && npm run build && npm run format:check && npm run format:rust:check && npm run lint:rust && npm run test:rust",
    "tauri": "tauri",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "test:version": "node --test scripts/version.test.mjs",
    "build:release": "node scripts/release-build.mjs",
    "release:manifest": "node scripts/updater-manifest.mjs",
    "test:release": "node --test scripts/updater-manifest.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@vscode/codicons": "0.0.46-24",
    "dompurify": "3.4.17",
    "material-icon-theme": "5.40.0",
    "mermaid": "12.3.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevPumpkin0113/oxidoc.git"
  },
  "bugs": {
    "url": "https://github.com/DevPumpkin0113/oxidoc/issues"
  },
  "homepage": "https://github.com/DevPumpkin0113/oxidoc"
}
